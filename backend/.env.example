# Copie para .env e ajuste. NUNCA suba o .env para o git.

# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:senha@localhost:5432/monitora

# Gere uma chave longa e aleatória:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True em produção (cookie só trafega em HTTPS). False em desenvolvimento (http://localhost).
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_EXPIRES_HOURS=8

# Origens permitidas no CORS, separadas por vírgula. Só é preciso em desenvolvimento,
# quando o front roda em outra porta (ex.: Live Server). Com front e API no mesmo
# domínio (nginx na VPS) pode ficar vazio.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Fuso usado para decidir se um horário já passou.
TIMEZONE=America/Fortaleza

# Em caso de uso do docker (lembre-se de trocar o localhost por "db"):
POSTGRES_PASSWORD=mesma-senha-colocada-no-sqlalchemydatabaseuri