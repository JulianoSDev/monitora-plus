# Copie para .env e ajuste. NUNCA suba o .env para o git.

# Formato: postgresql+psycopg://usuario:senha@host:porta/banco
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:troque-a-senha@db:5432/monitora
SECRET_KEY=troque-por-outra-chave-longa-e-aleatoria

# Gere uma chave longa e aleatória:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# GitHub Pages + API HTTPS (inclusive Quick Tunnel): string None e Secure=True.
# Em desenvolvimento HTTP local use JWT_COOKIE_SECURE=False e JWT_COOKIE_SAMESITE=Lax.
# Fora do Docker, substitua db por localhost na URI acima.
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None
JWT_EXPIRES_HOURS=8

# Origens exatas, separadas por vírgula, sem caminho /monitora-plus ou barra final.
CORS_ORIGINS=https://julianosdev.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Fuso usado para decidir se um horário já passou.
TIMEZONE=America/Sao_Paulo

# Em caso de uso do docker (lembre-se de trocar o localhost por "db"):
POSTGRES_PASSWORD=troque-a-senha

# Em HTTPS, defina códigos privados para TODAS as seis disciplinas antes do seed.
# scripts/create_env.py gera estes códigos e as chaves sem expô-los no terminal.
# JSON em uma linha; não use os códigos públicos do protótipo em uma API exposta.
PROFESSOR_CODES_JSON={"off-ihc":"TROQUE-IHC","off-es":"TROQUE-ES","off-aoc":"TROQUE-AOC","off-md":"TROQUE-MD","off-alg":"TROQUE-ALG","off-ing":"TROQUE-ING"}
